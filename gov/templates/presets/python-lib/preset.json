{
  "name": "python-lib",
  "description": "Python package projects: pytest and build gates wired into the DAG.",
  "gates": [
    {
      "id": "pytest",
      "label": "python tests",
      "command": ["python3", "-m", "pytest", "-q"],
      "paths": ["**/*.py", "pyproject.toml"]
    },
    {
      "id": "build",
      "label": "sdist+wheel build",
      "command": ["python3", "-m", "build"],
      "paths": ["**/*.py", "pyproject.toml"]
    }
  ],
  "modes": {
    "all": ["pytest", "build"],
    "quick": ["pytest"]
  }
}
