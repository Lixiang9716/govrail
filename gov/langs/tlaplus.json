{
  "classes": [
    "module"
  ],
  "comment": [
    "comment",
    "block_comment"
  ],
  "exclude": [
    ".git",
    ".hg",
    ".mypy_cache",
    ".pytest_cache",
    ".svn",
    ".tox",
    ".venv",
    "__pycache__",
    "build",
    "dist",
    "node_modules",
    "target",
    "venv",
    ".gov",
    ".agents"
  ],
  "functions": [
    "operator_definition",
    "function_definition",
    "procedure"
  ],
  "globs": [
    "*.tla"
  ],
  "grammar": "tree_sitter_tlaplus",
  "nesting": [
    "if_then_else",
    "case",
    "let_in",
    "bounded_quantification"
  ],
  "string": [
    "string"
  ]
}
