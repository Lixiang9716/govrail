{
  "modes": {
    "all": [
      "self-test",
      "notes",
      "pairing",
      "note-presence",
      "conflict-markers",
      "check",
      "rubric",
      "archive",
      "decisions",
      "task",
      "doc-sync",
      "plane"
    ],
    "quick": [
      "notes",
      "note-presence"
    ]
  },
  "defaultMode": "all",
  "concurrency": 4,
  "gates": [
    {
      "id": "self-test",
      "label": "governance rejection cases",
      "command": [
        "gov",
        "self-test"
      ],
      "paths": [
        "gov/**",
        "tests/**",
        "gates.json",
        "pyproject.toml"
      ]
    },
    {
      "id": "notes",
      "label": "note format",
      "command": [
        "gov",
        "note",
        "verify"
      ],
      "paths": [
        ".agents/notes/**"
      ]
    },
    {
      "id": "pairing",
      "label": "bilingual pairing",
      "command": [
        "gov",
        "verify",
        "pairing"
      ],
      "paths": [
        "docs/**",
        "README*",
        ".gov/pairing.json"
      ],
      "stages": [
        "pre-commit"
      ]
    },
    {
      "id": "note-presence",
      "label": "non-trivial changes carry an Agent Note (advisory)",
      "command": [
        "gov",
        "note",
        "presence"
      ]
    },
    {
      "id": "conflict-markers",
      "label": "no unresolved conflict markers in changed files",
      "command": [
        "gov",
        "verify",
        "conflict-markers"
      ],
      "stages": [
        "pre-commit"
      ]
    },
    {
      "id": "check",
      "label": "syntax-class static checks over product code (shipped + .gov/checks/ rules)",
      "command": [
        "gov",
        "check"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "rubric",
      "label": "review rubric structure",
      "command": [
        "gov",
        "verify",
        "rubric"
      ],
      "paths": [
        "docs/review-rubric.md",
        "docs/review-rubric.zh.md"
      ]
    },
    {
      "id": "archive",
      "label": "archived-notes seal",
      "command": [
        "gov",
        "note",
        "archive-verify"
      ],
      "paths": [
        ".agents/notes/archived/**"
      ]
    },
    {
      "id": "decisions",
      "label": "decisions table guard",
      "command": [
        "gov",
        "decision",
        "verify"
      ],
      "paths": [
        "docs/decisions.md",
        ".gov/decisions.json",
        ".gov/decisions/**"
      ]
    },
    {
      "id": "task",
      "label": "task cards",
      "command": [
        "gov",
        "task",
        "check"
      ],
      "paths": [
        ".gov/tasks/**"
      ]
    },
    {
      "id": "doc-sync",
      "label": "CHANGELOG ↔ HIGHLIGHTS pairing",
      "command": [
        "gov",
        "verify",
        "doc-sync"
      ],
      "paths": [
        "CHANGELOG.md",
        "gov/HIGHLIGHTS.md"
      ]
    },
    {
      "id": "plane",
      "label": "governance-plane seal (rules + gate set tamper-evidence)",
      "command": [
        "gov",
        "verify-plane"
      ],
      "paths": [
        ".gov/rules.md",
        "gates.json",
        ".gov/pairing.json",
        ".gov/plane-seal.json"
      ]
    }
  ]
}
