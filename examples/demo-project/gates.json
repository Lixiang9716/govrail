{
  "modes": {
    "all": [
      "notes",
      "pairing",
      "note-presence",
      "conflict-markers",
      "archive",
      "task",
      "plane",
      "decisions",
      "rubric",
      "source-limits"
    ],
    "quick": [
      "notes",
      "source-limits"
    ],
    "governance": [
      "plane"
    ]
  },
  "defaultMode": "all",
  "concurrency": 4,
  "gates": [
    {
      "id": "notes",
      "label": "note format",
      "command": [
        "gov",
        "verify-notes"
      ],
      "paths": [
        ".agents/notes/**"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "pairing",
      "label": "bilingual pairing (advisory until baselined)",
      "command": [
        "gov",
        "verify-pairing"
      ],
      "allowFailure": true,
      "stages": [
        "pre-commit"
      ],
      "paths": [
        "docs/**",
        "README*",
        ".gov/pairing.json"
      ],
      "timeoutMs": 180000
    },
    {
      "id": "note-presence",
      "label": "non-trivial changes carry an Agent Note (advisory)",
      "command": [
        "gov",
        "verify-note-presence"
      ],
      "timeoutMs": 60000
    },
    {
      "id": "conflict-markers",
      "label": "no unresolved conflict markers in changed files (issue #104)",
      "command": [
        "gov",
        "verify-conflict-markers"
      ],
      "stages": [
        "pre-commit"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "archive",
      "label": "archived-notes seal",
      "command": [
        "gov",
        "verify-archive"
      ],
      "paths": [
        ".agents/notes/archived/**"
      ],
      "timeoutMs": 60000
    },
    {
      "id": "task",
      "label": "task cards",
      "command": [
        "gov",
        "task",
        "check"
      ],
      "paths": [
        ".gov/tasks/**"
      ],
      "timeoutMs": 120000
    },
    {
      "id": "plane",
      "label": "governance-plane seal (rules + gate set tamper-evidence)",
      "command": [
        "gov",
        "verify-plane"
      ],
      "paths": [
        ".gov/rules.md",
        "gates.json",
        ".gov/pairing.json",
        ".gov/plane-seal.json"
      ],
      "timeoutMs": 60000
    },
    {
      "id": "decisions",
      "label": "decisions table guard",
      "command": [
        "gov",
        "verify-decisions"
      ],
      "paths": [
        "docs/decisions.md"
      ]
    },
    {
      "id": "rubric",
      "label": "review rubric structure",
      "command": [
        "gov",
        "verify-rubric"
      ],
      "paths": [
        "docs/review-rubric.md",
        "docs/review-rubric.zh.md"
      ]
    },
    {
      "id": "source-limits",
      "label": "module size limit (demo)",
      "command": [
        "sh",
        "-c",
        "exit 0"
      ],
      "paths": [
        "src/**",
        "eval/**"
      ]
    }
  ]
}
