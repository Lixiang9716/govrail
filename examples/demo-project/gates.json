{
  "modes": {
    "all": [
      "self-test",
      "notes",
      "pairing",
      "note-presence",
      "conflict-markers",
      "archive",
      "rubric",
      "decisions",
      "source-limits"
    ],
    "quick": [
      "notes",
      "source-limits"
    ],
    "governance": [
      "self-test"
    ]
  },
  "defaultMode": "all",
  "concurrency": 4,
  "gates": [
    {
      "id": "self-test",
      "label": "governance rejection cases (the govrail tools' own regression)",
      "command": [
        "gov",
        "self-test"
      ]
    },
    {
      "id": "notes",
      "label": "note format",
      "command": [
        "gov",
        "verify-notes"
      ],
      "paths": [
        ".agents/notes/**"
      ]
    },
    {
      "id": "pairing",
      "label": "bilingual pairing (advisory until baselined)",
      "command": [
        "gov",
        "verify-pairing"
      ],
      "allowFailure": true,
      "paths": [
        "docs/**",
        "README*",
        ".gov/pairing.json"
      ]
    },
    {
      "id": "note-presence",
      "label": "non-trivial changes carry an Agent Note (advisory)",
      "command": [
        "gov",
        "verify-note-presence"
      ]
    },
    {
      "id": "conflict-markers",
      "label": "no unresolved conflict markers in changed files (govrail built-in)",
      "command": [
        "gov",
        "verify-conflict-markers"
      ]
    },
    {
      "id": "rubric",
      "label": "review rubric structure",
      "command": [
        "gov",
        "verify-rubric"
      ],
      "paths": [
        "docs/review-rubric.md",
        "docs/review-rubric.zh.md"
      ]
    },
    {
      "id": "decisions",
      "label": "decisions table guard",
      "command": [
        "gov",
        "verify-decisions"
      ],
      "paths": [
        "docs/decisions.md"
      ]
    },
    {
      "id": "source-limits",
      "label": "module size limit (demo)",
      "command": [
        "sh",
        "-c",
        "exit 0"
      ],
      "paths": [
        "src/**",
        "eval/**"
      ]
    },
    {
      "id": "archive",
      "label": "archived-notes seal",
      "command": [
        "gov",
        "verify-archive"
      ],
      "paths": [
        ".agents/notes/archived/**"
      ]
    }
  ]
}
