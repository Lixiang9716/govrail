# The in-container E2E image: the adopter's environment, nothing more —
# the interpreter, git, and the installed govrail wheel. The BASE arg
# selects the matrix cell (python:3.10-slim … 3.13-slim, *-alpine for
# musl); pip resolves the tree-sitter dependency wheels at build time and
# they are BAKED in, so E2E runs are offline-fast and deterministic.
ARG BASE=python:3.12-slim
FROM ${BASE}

ARG PIP_INDEX_URL=https://pypi.org/simple
# Retries/timeout: the dependency wheels (tree-sitter, tens of MB) come
# from PyPI's CDN, which flaps on some networks — a build must ride out a
# read blip, not die on it.
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=8 \
    PYTHONIOENCODING=utf-8

# git: the lifecycle scenarios need repositories; the slim/alpine bases
# ship without it. Check-Valid-Until=false: an EOL suite's Release file
# goes stale on the mirror and apt refuses it (bullseye-security, seen
# live). bullseye additionally drops its SECURITY suite: post-EOL the
# security index points at .debs the mirror has already replaced (404s),
# and this time-boxed compat cell does not consume security updates —
# main carries the git it needs.
RUN if command -v apt-get >/dev/null 2>&1; then \
        . /etc/os-release \
        && if [ "${VERSION_CODENAME:-}" = "bullseye" ]; then \
            sed -i "/debian-security/d" /etc/apt/sources.list 2>/dev/null; \
            rm -f /etc/apt/sources.list.d/*; \
        fi \
        && apt-get -o Acquire::Check-Valid-Until=false update \
        && apt-get install -y --no-install-recommends \
            git ca-certificates && rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
        apk add --no-cache git ca-certificates; \
    fi

# The wheel built from the current checkout (the shipped artifact, not
# the source tree): pip resolves tree-sitter + grammar packs here, so a
# missing platform wheel fails the BUILD, loudly, not the E2E run.
COPY dist/govrail-*.whl /src/dist/
RUN pip install --no-cache-dir /src/dist/govrail-*.whl

COPY tests/docker_e2e/inner_e2e.py /usr/local/bin/inner_e2e.py
# the living specimen: the demo project rides along so every cell can
# prove a governed project stays governed (demo_specimen)
COPY examples/demo-project /demo
# the non-root cell reads the specimen as user 1000
RUN chmod -R a+rX /demo
ARG EXPECTED_VERSION
ENV GOV_E2E_EXPECTED_VERSION=${EXPECTED_VERSION}

WORKDIR /workspace
CMD ["python", "/usr/local/bin/inner_e2e.py"]
