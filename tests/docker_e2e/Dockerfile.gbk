# The hostile-locale cell: the C-locale job's premise (issue #172) — a
# host that does NOT speak UTF-8 — rebuilt on top of the standard e2e
# image. localedef bakes zh_CN.GBK into a user-space LOCPATH (no sudo
# dance at run time); LC_ALL makes every `gov` invocation decode with
# GBK, and PYTHONUTF8=0 keeps the interpreter honest about it.
#
# The anti-vacuous probe lives in inner_e2e.py (locale_bites): if the
# locale fails to take, the cell FAILS as vacuous instead of passing
# green while proving nothing.
FROM govrail-e2e:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends locales \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /locales \
    && localedef -i zh_CN -f GBK /locales/zh_CN.GBK

ENV LOCPATH=/locales \
    LC_ALL=zh_CN.GBK \
    PYTHONUTF8=0

CMD ["python", "/usr/local/bin/inner_e2e.py"]
